# Configuração do stack unificado (docker-compose.stack.yml).
# Copie para .env.stack e ajuste. NÃO comite o .env.stack real (segredos).
#   cp .env.stack.example .env.stack

# --- Backend ---
SERVER_PORT=8090                 # porta pública do backend (host:8090 -> container:8080)
GPS_POLLING_ENABLED=true
ROUTE_SHAPE_SOURCE=gtfs-service   # gtfs-service (liga OUT_OF_ROUTE + desvios) | disabled

# --- Postgres (backend) ---
DB_NAME=sppotracker
DB_USER=sppotracker
DB_PASSWORD=troque-esta-senha     # obrigatório

# --- Chave de API compartilhada backend <-> gtfs-service ---
# Mesmo valor nos dois lados: o gtfs exige X-Api-Key e o backend o envia.
# Deixe vazio para desabilitar a exigência (não recomendado em produção).
GTFS_API_KEY=troque-esta-chave

# --- sppo-gtfs-service / BigQuery ---
# GTFS_PROFILE vazio = BigQuery real. Use "demo" para subir sem credenciais (amostra).
GTFS_PROFILE=
GCP_PROJECT_ID=seu-projeto-de-billing
GTFS_VIAGEM_TABLE=rj-smtr.planejamento.viagem_planejada_dia
GTFS_SHAPES_TABLE=rj-smtr.planejamento.shapes_geom
BIGQUERY_LOCATION=US
GTFS_ADMIN_KEY=troque-esta-chave-admin

# Caminho do repo do gtfs-service (build context). Padrão: repo irmão.
GTFS_SERVICE_PATH=../sppo-gtfs-service

# Credenciais do GCP: coloque o JSON da service account em ./secrets/gcp-sa.json
# (o compose monta ./secrets em /secrets read-only). Necessário quando GTFS_PROFILE está vazio.
